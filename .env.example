POSTGRES_DB=gitddo
POSTGRES_USER=gitddo
POSTGRES_PASSWORD=gitddo
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/gitddo
DB_USERNAME=gitddo
DB_PASSWORD=gitddo

GITHUB_CLIENT_ID=replace-with-your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret
SESSION_COOKIE_SECURE=false
SPRINGDOC_ENABLED=true

GITDDO_GITHUB_CONNECT_TIMEOUT=5s
GITDDO_GITHUB_READ_TIMEOUT=30s
GITDDO_GITHUB_MAX_ATTEMPTS=3
GITDDO_GITHUB_RETRY_DELAY=1s

GITDDO_AI_MODE=mock
GITDDO_AI_MAX_ANALYSIS_DEPTH=P2
GITDDO_AI_BASE_URL=
GITDDO_AI_REPORTS_PATH=/internal/v1/portfolio-reports
GITDDO_AI_API_KEY=
GITDDO_AI_API_KEY_HEADER=X-Gitddo-Ai-Key
GITDDO_AI_CONNECT_TIMEOUT=5s
GITDDO_AI_READ_TIMEOUT=600s
GITDDO_AI_MAX_ATTEMPTS=3
GITDDO_AI_RETRY_DELAY=2s
